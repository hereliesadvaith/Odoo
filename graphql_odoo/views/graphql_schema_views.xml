<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Menu action for GraphQL Schema.-->
    <record id="graphql_schema_action" model="ir.actions.act_window">
        <field name="name">GraphQL Schema</field>
        <field name="res_model">graphql.schema</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No schema configured!
            </p>
        </field>
    </record>

    <!--Add menu inside technical menu.-->
    <menuitem
        id="graphql_schema_menu"
        parent="base.next_id_2"
        name="GraphQL Schema"
        action="graphql_schema_action"
    />

    <!--List view for GraphQL Schema-->
    <record id="graphql_schema_view_list" model="ir.ui.view">
        <field name="name">graphql.schema.view.list</field>
        <field name="model">graphql.schema</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ir_model_id"/>
                <field name="ir_model_fields_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!--Form view for GraphQL Schema.-->
    <record id="graphql_schema_view_form" model="ir.ui.view">
        <field name="name">graphql.schema.view.form</field>
        <field name="model">graphql.schema</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <br/>
                    <group>
                        <group>
                            <field name="ir_model_id"/>
                            <field name="ir_model_fields_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
